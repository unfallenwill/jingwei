%% jingwei's module dependency graph, after the round that made the
%% agent, the context and the run first-class.
%% Render me: paste into https://mermaid.live (or `mmdc -i jingwei-deps.mmd`).
%% The enforced contract is tests/architecture.rs; this picture is the tour.
%% One node per row of that test's LAYERS table, in the same seven groups.
%% Rule: dependencies point downward only. The ui port sits at the bottom
%% (everything emits through it); its adapters sit at the top (nothing may
%% depend on a frontend).
%% The one upward edge in the picture is the carve-out: the `config` family
%% (config, config::settings, config::login) may reach `api` (L4) for the
%% vendor table and the policy enums. It is drawn dashed, and it is the
%% only dashed edge here. A new L3 module that reaches for L4 is a
%% violation, not a carve-out.
%% `mcp::stub` and `test_util` are compiled only into the test build, so
%% their edges are not production edges and are not drawn.

flowchart TD
    subgraph L5["L5 — composition and the frontends"]
        agent["agent — the agent as a value"]
        lib["lib — the composition root"]
        main["main — the thin binary"]
        workflow["workflow — the run boundary"]
        agent_cmd["agent::cmd — the /agents verb"]
        agent_roster["agent::roster — the live agents"]
        agent_runner["agent::runner — the turn loop"]
        agent_tools["agent::tools — the fleet's four tools"]
        agent_worker["agent::worker — a background agent"]
        ui_plain["ui::plain — the log adapter"]
        ui_tui["ui::tui — the terminal adapter"]
        workflow_exec["workflow::exec — the fleet"]
        ui_tui_model["ui::tui::model — plain data"]
        ui_tui_update["ui::tui::update — pure event→state"]
        ui_tui_view["ui::tui::view — pure state→screen"]
    end
    subgraph L4["L4 — the model boundary"]
        api["api — transport, retry, policy<br/>(minimax · zai · deepseek)"]
        api_deepseek["api::deepseek — Chat Completions, thinking toggle"]
        api_minimax["api::minimax — the Messages wire"]
        api_zai["api::zai — Chat Completions, preserved thinking"]
    end
    subgraph L3["L3 — the tool/config tier"]
        config["config — argv grammar, resolver"]
        mcp["mcp — external servers' tools"]
        tools["tools — the registry"]
        config_login["config::login — the setup wizard"]
        config_settings["config::settings — persisted preferences"]
        mcp_client["mcp::client — one connection"]
        mcp_config["mcp::config — the server list"]
        mcp_health["mcp::health — is it up?"]
        mcp_http["mcp::http — the HTTP transport"]
        mcp_inner["mcp::inner — the hub's actor"]
        mcp_stdio["mcp::stdio — the stdio transport"]
        mcp_wire["mcp::wire — the JSON-RPC vocabulary"]
        tools_edit["tools::edit — the exact-then-line edit"]
        tools_ledger["tools::ledger — the per-agent file ledger"]
        tools_runtime["tools::runtime — the tool runtime"]
    end
    subgraph L2["L2 — per-agent state and the ports"]
        core_context["core::context — the per-agent model state"]
        core_ports["core::ports — the tool boundary"]
        core_prompt["core::prompt — the prompt's own module"]
    end
    subgraph L1["L1 — infra primitives"]
        cancel["cancel — the cancel tree"]
        file_io["file_io — atomic writes"]
        core_agents_md["core::agents_md —<br/>convention discovery"]
        core_reminder["core::reminder —<br/>in-band system reminders"]
    end
    subgraph L0["L0 — pure data, state machines, and the display port"]
        core["core — the cluster's root"]
        format["format — bytes & width"]
        ui["ui — the output port<br/>(Msg · Sev · Show · paint)"]
        core_error["core::error — Error and Result"]
        core_ids["core::ids — the agent identity"]
        core_ir["core::ir — the conversation<br/>language + user_message"]
        core_session["core::session — persistence"]
        core_turn["core::turn — run state machine"]
    end
    subgraph T["T — test-only"]
        test_util["test_util — test-only helpers"]
        mcp_stub["mcp::stub — the test fixture"]
    end

